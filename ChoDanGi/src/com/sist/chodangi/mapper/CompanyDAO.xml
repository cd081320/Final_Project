<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.chodangi.common.ICompanyDAO">
	
	<!-- search -->
	<select id="search" resultType="com.sist.chodangi.common.CompanyDTO">
		SELECT ID, LOCATION_ID, NAME, LOCATION, DETAILS, POSTADDR, ROADADDR
		FROM COMPANY
		WHERE ID = #{id}
	</select>
</mapper>